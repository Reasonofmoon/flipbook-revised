# Copy to .env and fill in. Generate random values with:
#   openssl rand -hex 32
FLIPBOOK_BASE_URL=http://localhost:8080
FLIPBOOK_API_KEY=
FLIPBOOK_SESSION_SECRET=
# UI language for viewer and admin pages: auto, ko, or en
# (auto: viewer follows each flipbook's content, admin follows the browser)
FLIPBOOK_UI_LANG=auto
# Admin login password (8+ chars, no spaces). Apply with:
#   docker compose exec -T app sh -c 'echo "$FLIPBOOK_ADMIN_PASSWORD" | ./flipbook set-password'
FLIPBOOK_ADMIN_PASSWORD=
